{
  "name": "eppley-shared",
  "version": "1.0.0",
  "description": "Types and zod schemas shared between client and server",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "clean": "node scripts/clean.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "exports": {
    "./api": {
      "types": "./dist/api.types.d.ts",
      "default": "./dist/api.types.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.schemas.d.ts",
      "default": "./dist/schemas/*.schemas.js"
    }
  }
}
