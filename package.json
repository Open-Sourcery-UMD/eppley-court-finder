{
  "name": "eppley-court-finder",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck --ws --if-present",
    "lint": "npm run lint --ws --if-present",
    "clean": "npm run clean --ws --if-present && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "zod": "^4.4.3"
  }
}
